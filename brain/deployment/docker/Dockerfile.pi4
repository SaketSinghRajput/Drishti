FROM python:3.9-slim-bookworm AS base

# Build-time ARG to optionally include EdgeTPU runtime libs
ARG WITH_EDGETPU=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libatlas-base-dev \
        libopenblas0 \
        v4l-utils \
        can-utils \
        libgomp1 \
        libi2c-dev \
    && if [ "${WITH_EDGETPU}" = "true" ]; then \
         apt-get install -y --no-install-recommends libedgetpu1-std; \
       fi \
    && rm -rf /var/lib/apt/lists/*

# Use the Pi-optimized runtime requirements file if present
COPY requirements-runtime.txt /requirements.txt

# Upgrade pip early to get latest resolver improvements and wheels support
RUN pip install --upgrade pip

# Install Python build dependencies temporarily so packages without manylinux
# wheels (psutil, spidev, sysv_ipc) can be built on-device. These are removed
# after installing Python packages to keep the final image small.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        python3-dev \
        libffi-dev \
        libssl-dev \
    && pip install --no-cache-dir --prefer-binary --timeout=1000 -r /requirements.txt \
    && apt-get remove -y --purge build-essential gcc python3-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

FROM base AS runtime
COPY . /app
WORKDIR /app
RUN useradd -m evuser \
    && mkdir -p /home/pi \
    && chown -R evuser:evuser /app /home/pi /models /config || true

# Switch to unprivileged user for runtime
USER evuser
EXPOSE 5000-5003/tcp
# Lightweight python-based healthcheck to avoid requiring curl in runtime image
HEALTHCHECK --interval=30s --timeout=10s CMD python -c "import sys,urllib.request; \
try:\
    r=urllib.request.urlopen('http://localhost:5000/health', timeout=5); \
    code=r.getcode(); sys.exit(0 if code==200 else 1)\
except Exception:\
    sys.exit(1)"
# Use the orchestrator as the container entrypoint for full-system runs
ENTRYPOINT ["python3", "main.py"]
CMD ["--config", "/config/default_config.yaml", "--mode", "prod"]
